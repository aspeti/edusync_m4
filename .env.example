# Copiar a `.env` (gitignored) o exportar en la shell / IDE.
# NUNCA pegar valores reales en archivos versionados.

# --- LLM provider: ollama | open-webui ---
EDUSYNC_AI_ENABLED=true
EDUSYNC_AI_PROVIDER=open-webui

# Ollama directo (si EDUSYNC_AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT_SECONDS=120

# Open WebUI (si EDUSYNC_AI_PROVIDER=open-webui)
OPEN_WEBUI_BASE_URL=http://localhost:3000
OPEN_WEBUI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxx
OPEN_WEBUI_MODEL=llama3.1:latest
OPEN_WEBUI_TIMEOUT_SECONDS=120
