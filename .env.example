# Copiar a `.env` (gitignored) o exportar en la shell / IDE.
# NUNCA pegar valores reales en archivos versionados.

# --- LLM provider: ollama | open-webui | openai (ChatGPT) | gemini ---
EDUSYNC_AI_ENABLED=true
EDUSYNC_AI_PROVIDER=gemini
EDUSYNC_AI_AGENTE_PROVIDER=gemini

# Ollama directo (si EDUSYNC_AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT_SECONDS=120

# Open WebUI (si EDUSYNC_AI_PROVIDER=open-webui)
OPEN_WEBUI_BASE_URL=http://localhost:3000
OPEN_WEBUI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxx
OPEN_WEBUI_MODEL=llama3.1:latest
OPEN_WEBUI_TIMEOUT_SECONDS=120

# OpenAI / ChatGPT (si EDUSYNC_AI_PROVIDER=openai). Solo para tools CLI (GenerarTest);
# no commitear la clave. El backend shared.ai sigue usando ollama|open-webui.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_SECONDS=120

# Google Gemini (si EDUSYNC_AI_PROVIDER=gemini). API key de Google AI Studio.
# El backend usa el endpoint OpenAI-compat. No commitear la clave.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_TIMEOUT_SECONDS=120
# Para el asistente solo: EDUSYNC_AI_AGENTE_PROVIDER=gemini
# Si EDUSYNC_AI_AGENTE_MODEL sigue en llama3.1:8b, el agente usa GEMINI_MODEL.

# Agente ReAct (POST /api/v1/ai/agente). Tag fijo, nunca latest.
EDUSYNC_AI_AGENTE_HABILITADO=true
EDUSYNC_AI_AGENTE_MODEL=llama3.1:8b
EDUSYNC_AI_AGENTE_MAX_TURNOS=6
EDUSYNC_AI_AGENTE_LLM_HABILITADO=true
