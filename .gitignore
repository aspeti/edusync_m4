# Backend (Maven)
backend/target/
backend/.mvn/
backend/*.log

# Frontend build output (frontend/ tiene su propio .gitignore para node_modules/dist)
frontend/dist/
frontend/.angular/

# IDE / OS
.idea/
*.iml
.DS_Store
Thumbs.db

# Variables de entorno / secretos locales (NUNCA commitear valores reales)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.p12
*.jks
secrets/
**/secrets/

# Playwright E2E (tests/e2e)
tests/e2e/node_modules/
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/blob-report/
tests/e2e/playwright/.cache/
tests/e2e/.env.e2e
tests/e2e/specs/plan_agente.md

# Perfiles Spring locales con secretos (usar application-local.yml.example como plantilla)
**/application-local.yml
**/application-local.yaml
**/application-secret.yml
**/application-secret.yaml
