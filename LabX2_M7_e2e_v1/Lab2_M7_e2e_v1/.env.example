# Copiar a .env y ajustar. Mismas variables que el Lab6 del Modulo 6.
#
# Opcion A — modelo local (gratis, sin red): el servidor del M6 en el puerto 11434
LOCALHOST_BASE_URL=http://localhost:11434/v1
LOCALHOST_API_KEY=local
LOCALHOST_MODEL=llama3.2:3b
#
# Opcion B — proveedor remoto (capa gratuita o de pago): descomentar y completar
# OPENAI_BASE_URL=https://<url-del-proveedor>/v1
# OPENAI_API_KEY=<clave>
# OPENAI_MODEL=<modelo>
