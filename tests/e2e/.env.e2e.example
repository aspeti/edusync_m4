# Copiar a .env.e2e (gitignored). Credenciales locales — NUNCA commitear valores reales.

# SPA bajo prueba (ng serve + proxy /api → :8080)
E2E_BASE_URL=http://127.0.0.1:4200

# Seed SYSADMIN de plataforma (application.yml)
E2E_SYSADMIN_EMAIL=sysadmin@edusync.local
E2E_SYSADMIN_PASSWORD=changeme_local_dev

# ADMIN del tenant demo (consola académica / usuarios)
E2E_ADMIN_EMAIL=demo@mail.com
E2E_ADMIN_PASSWORD=Demo123*

# Opcional: navegador ya instalado
# CHROMIUM_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Opcional: correr headed
# E2E_HEADED=1
