# Copiar a tools/m7-unit/.env o usar el .env de la raiz del repo.
# Mismas variables que LabX_M7_unit / Lab6. NUNCA commitear claves reales.

# Opcion A — Ollama local (gratis)
LOCALHOST_BASE_URL=http://localhost:11434/v1
LOCALHOST_API_KEY=local
LOCALHOST_MODEL=llama3.1:latest

# Opcion B — si no hay LOCALHOST_*/OPENAI_*, se usan las de EduSync:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:latest
# EDUSYNC_AI_PROVIDER=ollama
#
# Si no hay LOCALHOST_*/OPENAI_*, este CLI usa Ollama /v1 (no Open WebUI).
# Para forzar WebUI: M7_PROVIDER=open-webui
# TIMEOUT_MODELO=300
